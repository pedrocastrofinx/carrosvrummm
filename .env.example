# Copie para .env SOMENTE se for rodar algo localmente. Nunca versione o .env (ja esta no .gitignore).
# Na Vercel, estas variaveis vao em Settings > Environment Variables. No GitHub, em Settings > Secrets and variables > Actions.

# --- Vercel (rotas /api) ---
ANTHROPIC_API_KEY=            # chave da Anthropic (Clove). So no servidor.
SUPABASE_URL=                 # https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=            # chave "anon public" (pode ir ao navegador)
# CLOVE_MODEL=claude-sonnet-5-5   # opcional

# --- Scripts locais / GitHub Actions ---
YOUTUBE_API_KEY=              # YouTube Data API v3 (restrinja a chave a essa API no Google Cloud)
SUPABASE_SERVICE_ROLE_KEY=    # chave SECRETA (service_role). Usada so por tools/enviar_tabela_supabase.py. NUNCA na Vercel nem no navegador.
